---
import '../styles/global.css';

const DISCORD_URL    = 'https://discord.gg/9k59CD6mC6';
const MESHMAPPER_URL = 'https://pgv.meshmapper.net/';
const CONTACT_EMAIL  = 'info@pgvmesh.org';
const GITHUB_URL     = 'https://github.com/pgvmesh/www';
const FLASHER_URL    = 'https://flasher.meshcore.io/';

const MAP_EMBED  = 'https://pgv.meshmapper.net/embed.php?zoom=11';
const HERO_EMBED = 'https://pgv.meshmapper.net/embed.php?fail_grid=1&zoom=11';

const legend = [
  ['#2e9e46', 'confirmed two-way'],
  ['#22b8b8', 'discovery reply'],
  ['#d9822b', 'sent, not repeated'],
  ['#8b5fbf', 'heard only'],
  ['#8b8578', 'dead repeater'],
  ['#c0392b', 'no coverage'],
];

const channels = [
  ['#ncmesh',         'General chat for the North Carolina mesh community'],
  ['#pgv-area-mesh',  'Our local PGV Mesh channel for area coordination'],
  ['#pgv-wx',         'Weather watches, warnings, and local storm reports'],
  ['#pgv-test',       'Range and signal testing: a good place to confirm “Heard 1 repeat”'],
  ['#pgv-bot',        'Automated bot traffic: keep casual chat on the other channels'],
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="PGV Mesh is a volunteer-run LoRa radio network around Greenville and Pitt County, North Carolina. How to join, the MeshCore settings we use, and a live map of who is on the air." />
  <title>PGV Mesh</title>
  <link rel="canonical" href="https://pgvmesh.org/" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Zilla+Slab:wght@400;600;700&family=Public+Sans:wght@400;600;700&family=Martian+Mono:wght@400;600&display=swap" rel="stylesheet" />

  <!-- Social preview -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://pgvmesh.org/" />
  <meta property="og:title" content="PGV Mesh" />
  <meta property="og:description" content="A volunteer-run radio network around Greenville and Pitt County. Messages hop radio to radio, so it keeps working when the towers go down." />
  <meta property="og:image" content="https://pgvmesh.org/og.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="PGV Mesh" />
  <meta name="twitter:description" content="A volunteer-run radio network around Greenville and Pitt County. Messages hop radio to radio, so it keeps working when the towers go down." />
  <meta name="twitter:image" content="https://pgvmesh.org/og.png" />
</head>
<body>

  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="brand">
      <svg class="brand-mark" viewBox="0 0 100 100" fill="none" aria-hidden="true">
        <circle cx="50" cy="50" r="38" stroke="#9fd63a" stroke-width="6"/>
        <path d="M50 22 L26 68 L74 68 Z" stroke="#9fd63a" stroke-width="5" stroke-linejoin="round"/>
        <circle cx="50" cy="22" r="6" fill="#9fd63a"/>
        <circle cx="26" cy="68" r="6" fill="#9fd63a"/>
        <circle cx="74" cy="68" r="6" fill="#9fd63a"/>
      </svg>
      <span class="brand-name">PGV Mesh</span>
      <span class="brand-place">Greenville &amp; Pitt County, NC</span>
    </div>
    <button class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    <nav class="site-nav" id="site-nav">
      <a class="link" href="#start">Get Started</a>
      <a class="link" href="#map">Map</a>
      <a class="link" href="#reference">Settings</a>
      <a class="link" href="#volunteer">Volunteer</a>
      <a class="link" href={`mailto:${CONTACT_EMAIL}`}>Contact</a>
    </nav>
  </header>

  <main id="main" tabindex="-1">

  <!-- Hero -->
  <section class="hero">
    <iframe
      class="hero-map"
      src={HERO_EMBED}
      title="PGV Mesh live region map"
      loading="lazy"
      scrolling="no"
      aria-hidden="true"
      tabindex="-1"
    ></iframe>
    <div class="hero-panel">
      <span class="eyebrow">Eastern North Carolina · Off-Grid Radio</span>
      <h1>A radio network for eastern North Carolina, built by neighbors.</h1>
      <p>PGV Mesh is a volunteer-built radio network around Greenville and Pitt County. It carries text messages hop by hop between MeshCore radios, with no cell towers, no internet, and no subscription.</p>
      <div class="hero-actions">
        <a class="btn btn-fill" href="#start">Get a compatible radio</a>
        <a class="btn btn-ghost" href="#map">View the live map</a>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="how">
    <img
      class="photo how-photo"
      src="/img/device-closeup.webp"
      width="518"
      height="680"
      loading="lazy"
      alt="A hand holding a SenseCAP card-sized MeshCore node with its circuit board visible through the translucent case."
    />
    <div>
      <span class="eyebrow">How it works</span>
      <h2>Radio to radio, house to house.</h2>
      <p>
        Each radio in the network, called a node, runs free <a class="link" href="https://meshcore.io/" target="_blank" rel="noopener">MeshCore</a> firmware and talks directly over LoRa radio waves. No node needs the internet or a cell signal. When your message is out of direct range, a nearby repeater picks it up and passes it along, hop by hop, until it reaches someone who can act on it.
      </p>
      <p>
        There's no central tower or server to fail. Every repeater was placed by a volunteer, several run on solar power, and the mesh carries ordinary chat every day, so it's already working before anyone needs it to.
      </p>
      <div class="hop-diagram">
        <div class="hop">
          <svg class="hop-icon" viewBox="0 0 32 32" aria-hidden="true">
            <rect x="10" y="12" width="12" height="16"/>
            <line x1="13" y1="16.5" x2="19" y2="16.5"/>
            <line x1="19.5" y1="12" x2="23" y2="5"/>
          </svg>
          <span>your radio</span>
        </div>
        <div class="hop-line"></div>
        <div class="hop">
          <svg class="hop-icon" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M11 29 L16 13 L21 29"/>
            <line x1="12.7" y1="23.5" x2="19.3" y2="23.5"/>
            <path d="M11.5 10.5 a6.4 6.4 0 0 1 9 0"/>
            <path d="M8.5 7 a10.6 10.6 0 0 1 15 0"/>
          </svg>
          <span>a repeater</span>
        </div>
        <div class="hop-line"></div>
        <div class="hop">
          <svg class="hop-icon" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M7 16 L16 9 L25 16"/>
            <path d="M10 14.5 L10 26 L22 26 L22 14.5"/>
            <rect x="14" y="19.5" width="4" height="6.5"/>
          </svg>
          <span>a neighbor</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Get started -->
  <section id="start" class="start">
    <span class="eyebrow">Get on the mesh</span>
    <h2>Four steps, about $20&ndash;40 in parts.</h2>
    <div class="start-layout">
      <div>
        <div class="step">
          <span class="step-num">1</span>
          <div>
            <strong>Get a device</strong>
            <p>Any board listed in the <a class="link" href={FLASHER_URL} target="_blank" rel="noopener">MeshCore Web Flasher</a> works, most costing $20&ndash;40.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-num">2</span>
          <div>
            <strong>Flash it in your browser</strong>
            <p>Plug into USB at <a class="link" href={FLASHER_URL} target="_blank" rel="noopener">flasher.meshcore.io</a> and flash the Companion firmware, then pair with the MeshCore phone app over Bluetooth.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-num">3</span>
          <div>
            <strong>Apply our <a class="link" href="#reference">settings</a></strong>
            <p>Select the USA/Canada preset, pick a node name, and set the 3-byte path hash.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-num">4</span>
          <div>
            <strong>Send an advert and say hello</strong>
            <p>Tap the advert (wave) icon to announce yourself. Contacts only appear after <em>they</em> advert too, so be patient. A test message showing &ldquo;Heard 1 repeat&rdquo; means you're on the mesh: tell us on <a class="link" href={DISCORD_URL} target="_blank" rel="noopener">Discord</a>.</p>
          </div>
        </div>
      </div>
      <img
        class="photo start-photo"
        src="/img/onboard-device.webp"
        width="390"
        height="520"
        loading="lazy"
        alt="An unboxed Heltec LoRa board with a screw-on antenna and a small battery pack."
      />
    </div>
  </section>

  <!-- Live map -->
  <section id="map" class="map">
    <div class="map-head">
      <span class="eyebrow">Live network map</span>
      <h2>Every node currently on the air.</h2>
    </div>
    <div class="map-frame">
      <iframe src={MAP_EMBED} title="PGV Mesh full live region map" loading="lazy"></iframe>
      <button class="map-shield" type="button">
        <span>Enable map interaction</span>
      </button>
    </div>
    <div class="map-legend">
      <div>
        {legend.map(([color, label]) => (
          <span class="key"><span class="swatch" style={`background:${color}`}></span>{label}</span>
        ))}
      </div>
      <a class="link map-open" href={MESHMAPPER_URL} target="_blank" rel="noopener">Open full-screen map ↗</a>
    </div>
  </section>

  <!-- Outage context -->
  <section class="outage">
    <p>
      Eastern North Carolina loses cell and internet service most often during hurricane season and after ice storms, when downed lines and flooded roads can keep repair crews out for days. A LoRa mesh doesn't route through that infrastructure at all. Radios keep relaying to each other as long as they have power, which is why several PGV repeaters run on solar.
    </p>
  </section>

  <!-- Technical reference -->
  <section id="reference" class="reference">
    <span class="eyebrow">Technical reference</span>
    <h2>Settings, channels, emergencies, and observers.</h2>

    <details class="ref">
      <summary><span>Companion, Repeater &amp; Room Server settings</span> <span class="ref-chev">+</span></summary>
      <div class="settings-grid">
        <div class="settings-card">
          <h3>Companion</h3>
          <div class="role">Your phone-connected node</div>
          <dl class="spec">
            <dt>Preset</dt><dd>USA/Canada<br />910.525 MHz &middot; 62.5 kHz &middot; SF7</dd>
            <dt>Coding Rate</dt><dd>8</dd>
            <dt>Node Name</dt><dd class="plain">Your choice</dd>
            <dt>Path Hash</dt><dd>3-byte</dd>
          </dl>
        </div>
        <div class="settings-card">
          <h3>Repeater</h3>
          <div class="role">A fixed node that extends coverage</div>
          <dl class="spec">
            <dt>Preset</dt><dd>USA/Canada<br />910.525 MHz &middot; 62.5 kHz &middot; SF7</dd>
            <dt>Coding Rate</dt><dd>8</dd>
            <dt>Node Name</dt><dd class="plain">pgvmesh.org &lt;area&gt;<br /><span class="sub">e.g. pgvmesh.org Grimesland</span></dd>
            <dt>Path Hash</dt><dd>3-byte</dd>
            <dt>Zero-Hop</dt><dd>every 60 min</dd>
            <dt>Flood Advert</dt><dd>every 3 hrs</dd>
            <dt>Console</dt><dd class="cmds">set txdelay 0.3<br />set direct.txdelay 0.1<br />set agc.reset.interval 4<br />set multi.acks 1<br />set rxdelay 3</dd>
          </dl>
        </div>
        <div class="settings-card">
          <h3>Room Server</h3>
          <div class="role">Hosts a shared, store-and-forward room</div>
          <dl class="spec">
            <dt>Node Name</dt><dd class="plain">pgvmesh.org &lt;area&gt;<br /><span class="sub">same convention as a repeater</span></dd>
            <dt>Commands</dt><dd class="cmds">password &lt;admin&gt;<br />set guest.password &lt;room-pw&gt;<br />set allow.read.only on <span class="opt">(optional)</span></dd>
          </dl>
          <p class="note">Not a repeater: leave <code>repeat</code> off. <a class="link" href="https://docs.meshcore.io/" target="_blank" rel="noopener">MeshCore</a> recommends a separate device.</p>
        </div>
      </div>
      <p class="settings-source">Based on <a class="link" href="https://tennmesh.com/settings/" target="_blank" rel="noopener">TennMesh's reference settings</a>, adjusted for our sparse coverage. Planning a repeater? Coordinate first on <a class="link" href={DISCORD_URL} target="_blank" rel="noopener">Discord</a>.</p>
    </details>

    <details class="ref">
      <summary><span>Channels</span> <span class="ref-chev">+</span></summary>
      <div class="ref-body">
        <p>Every companion starts on the shared <strong>Public</strong> channel. To join a topic, add a channel in the MeshCore app whose name starts with <code>#</code>; the app derives the shared key from the name, so anyone using the exact same name lands on the same channel. These are the ones we use across the region:</p>
        <dl class="channels">
          {channels.map(([name, desc]) => (
            <>
              <dt>{name}</dt><dd>{desc}</dd>
            </>
          ))}
        </dl>
        <p class="fine">Channel names are case-sensitive and generate their own key: type them exactly as shown. Want a new channel? Suggest it on <a class="link" href={DISCORD_URL} target="_blank" rel="noopener">Discord</a> so we can keep everyone on the same names.</p>
      </div>
    </details>

    <details class="ref">
      <summary><span>Emergencies without cell or internet</span> <span class="ref-chev">+</span></summary>
      <div class="ref-body">
        <p>If cellular and internet are completely down, a MeshCore companion node still sends text messages across the mesh.</p>
        <p><strong>1. Send a message on the public channel.</strong> State your location, the emergency, and what help you need. Short messages relay further and more reliably.</p>
        <p><strong>2. The mesh carries it.</strong> Your message hops repeater-to-repeater across the region, even without direct range to anyone.</p>
        <p><strong>3. Someone bridges to help.</strong> Members with working power or internet relay your report to 911 or family.</p>
        <p><strong>4. Stay reachable.</strong> Keep your node powered and watch for replies.</p>
        <p class="fine">The mesh is a community best-effort network, not a replacement for 911. Use an official emergency channel first if one is available to you.</p>
      </div>
    </details>

    <details class="ref">
      <summary><span>Become an observer</span> <span class="ref-chev">+</span></summary>
      <div class="ref-body">
        <p>An observer feeds live mesh traffic to <a class="link" href={MESHMAPPER_URL} target="_blank" rel="noopener">our region map</a> over MQTT. It's a function, not a firmware role: any node can run it, with the same radio settings as everything else. Follow the <a class="link" href="https://wiki.meshmapper.net/mqtt-main/" target="_blank" rel="noopener">MeshMapper observer guide</a>, or ask on <a class="link" href={DISCORD_URL} target="_blank" rel="noopener">Discord</a>.</p>
      </div>
    </details>
  </section>

  <!-- Volunteer -->
  <section id="volunteer" class="volunteer">
    <div>
      <span class="eyebrow">Host a repeater</span>
      <h2>Height wins. Put one on your roof, barn, or silo.</h2>
      <p>A solar-powered repeater costs $30&ndash;60 in parts and runs on its own, with no wiring and no internet. LoRa uses the license-free 902&ndash;928 MHz band, the same as garage door openers, and won't interfere with WiFi, cellular, or aviation. Build one, fund one, or just offer the spot, and we'll handle setup.</p>
      <div class="volunteer-actions">
        <a class="btn btn-fill" href={DISCORD_URL} target="_blank" rel="noopener">Volunteer on Discord</a>
        <a class="btn btn-ghost" href={`mailto:${CONTACT_EMAIL}`}>Email {CONTACT_EMAIL}</a>
      </div>
    </div>
    <img
      class="photo volunteer-photo"
      src="/img/repeater-install.webp"
      width="640"
      height="640"
      loading="lazy"
      alt="A PGV Mesh repeater in a green weatherproof enclosure strapped to a utility pole, antenna pointing skyward."
    />
  </section>

  </main>

  <footer class="site-footer">
    <span>PGV Mesh, community-run MeshCore network</span>
    <div>
      <a class="link" href={DISCORD_URL} target="_blank" rel="noopener">Discord</a>
      <a class="link" href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
      <a class="link" href="https://meshcore.io/" target="_blank" rel="noopener">meshcore.io</a>
      <a class="link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </div>
  </footer>

  <script>
    const shield = document.querySelector('.map-shield');
    shield?.addEventListener('click', () => {
      const frame = shield.previousElementSibling as HTMLIFrameElement | null;
      if (frame) frame.style.pointerEvents = 'auto';
      (shield as HTMLElement).style.display = 'none';
    });

    const navToggle = document.querySelector('.nav-toggle');
    const siteNav = document.querySelector('.site-nav');
    if (navToggle && siteNav) {
      const setNav = (open: boolean) => {
        siteNav.classList.toggle('open', open);
        navToggle.setAttribute('aria-expanded', String(open));
      };
      navToggle.addEventListener('click', () => setNav(!siteNav.classList.contains('open')));
      siteNav.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).tagName === 'A') setNav(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || !siteNav.classList.contains('open')) return;
        setNav(false);
        (navToggle as HTMLElement).focus();
      });
    }
  </script>

</body>
</html>
